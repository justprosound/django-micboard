{
  "name": "django-micboard-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for django-micboard, built with Astro Starlight.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justprosound/django-micboard.git"
  },
  "bugs": {
    "url": "https://github.com/justprosound/django-micboard/issues"
  },
  "homepage": "https://github.com/justprosound/django-micboard#readme",
  "scripts": {
    "docs:assets": "node ./scripts/sync-docs-assets.mjs",
    "docs:build": "npm run docs:assets && astro build",
    "docs:dev": "npm run docs:assets && astro dev --port 9000 --ignore-lock",
    "docs:preview": "astro preview --port 9000 --ignore-lock",
    "docs:check": "astro check",
    "docs:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.2",
    "astro": "^7.3.3",
    "github-slugger": "^2.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
